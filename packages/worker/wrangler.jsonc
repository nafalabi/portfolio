{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "vars": {
    "CORS_ALLOWED_ORIGINS": "https://nandaabi.my.id",
    "MAILGUN_DOMAIN": "REPLACE_WITH_MAILGUN_DOMAIN",
    "MAILGUN_FROM_EMAIL": "noreply@nandaabi.my.id",
    "CV_DRIVE_URL": "REPLACE_WITH_DRIVE_URL",
    "CV_BLOCKED_DOMAINS": "",
    "CV_RATE_LIMIT_MAX": "3",
    "CV_RATE_LIMIT_WINDOW_SECONDS": "86400"
  },
  "kv_namespaces": [{ "binding": "CV_RATE_LIMIT_KV", "id": "deadbeefdeadbeefdeadbeefdeadbeef" }],
  "observability": { "enabled": true }
}
